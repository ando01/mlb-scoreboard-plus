# MLB LED Scoreboard Configuration

# Display Settings
LED_ROWS=64
LED_COLS=128
LED_CHAIN=1
LED_PARALLEL=1
LED_BRIGHTNESS=30
LED_GPIO_MAPPING=adafruit-hat
LED_GPIO_SLOWDOWN=4

# Power Management (to prevent Pi reboots)
# Start brightness (prevents power surge on startup)
LED_STARTUP_BRIGHTNESS=10
# Brightness ramp time in seconds
LED_RAMP_TIME=2

# Color Quality Settings (prevent fading/contrast issues)
LED_PWM_BITS=11              # Color depth (1-11, higher = better colors but more CPU)
LED_PWM_LSB_NANOSECONDS=200  # PWM timing (lower = brighter/harsher, higher = softer/smoother)
LED_LIMIT_REFRESH=0          # Refresh rate limit in Hz (0 = no limit)
LED_RGB_SEQUENCE=RGB         # Color order (RGB, RBG, GRB, etc.)

# Flickering Reduction Settings
LED_PWM_DITHER_BITS=0        # PWM dithering (0 = none, 1-2 = reduce flickering)
LED_SCAN_MODE=1              # 0 = progressive, 1 = interlaced (1 can reduce flicker)
LED_ROW_ADDRESS_TYPE=0       # 0 = default, 1-4 = alternative (try different values if flickering)

# Application Settings
FAVORITE_TEAM=NYY
UPDATE_INTERVAL=10
ROTATION_INTERVAL=15

# API Settings
MLB_API_BASE_URL=https://statsapi.mlb.com

# Web UI Settings
WEB_UI_PORT=8080
WEB_UI_HOST=0.0.0.0

# Development Mode (set to true to use emulator)
DEV_MODE=false
