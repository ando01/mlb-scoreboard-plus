# MLB LED Scoreboard Configuration

# Display Settings
LED_ROWS=64
LED_COLS=128
LED_CHAIN=1
LED_PARALLEL=1
LED_BRIGHTNESS=60
LED_GPIO_MAPPING=adafruit-hat

# Application Settings
FAVORITE_TEAM=NYY
UPDATE_INTERVAL=10
ROTATION_INTERVAL=15

# API Settings
MLB_API_BASE_URL=https://statsapi.mlb.com

# Web UI Settings
WEB_UI_PORT=8080
WEB_UI_HOST=0.0.0.0

# Development Mode (set to true to use emulator)
DEV_MODE=false
